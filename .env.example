# LLM (OpenAI ou Azure OpenAI)
OPENAI_API_KEY=sua_openai_key_here
OPENAI_MODEL=nome_modelo

# Embeddings
EMBEDDING_MODEL=embedding_modelo

# Vector Store
CHROMA_PERSIST_DIR=pata_vetor_store

# App
APP_ENV=app_env
LOG_LEVEL=type_log_level

# Hugging Face
HF_TOKEN=seu_token_aqui
HF_HUB_DISABLE_SYMLINKS_WARNING=1